# Pathwise AI Environment Configuration

# Frontend (apps/web) Config
VITE_APP_TITLE=Pathwise AI
VITE_API_URL=http://localhost:8000/api/v1
# (Optional) Pre-configure Gemini API Key for Frontend
VITE_GEMINI_API_KEY=

# FastAPI Backend (apps/api) Config
PORT=8000
ENVIRONMENT=development
# Gemini API Key for Python Backend Service
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Database & Auth (Optional for future phases)
DATABASE_URL=postgresql://user:password@localhost:5432/pathwise
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

